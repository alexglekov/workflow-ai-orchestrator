DATABASE_URL=postgresql://aiworker:aiworker@localhost:5436/aiworker?schema=public
ENCRYPTION_KEY=dev-encryption-key-change-me
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
AGENT_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Official Google endpoint is geo-blocked in some countries; use a proxy URL if needed.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
PORT=3000
PUBLIC_API_URL=http://localhost:3000/api
# Optional: password for API if it is reachable beyond localhost
API_PASSWORD=
# Timezone for daily schedule triggers (HH:MM). Overridable per trigger.
SCHEDULE_TZ=Europe/Moscow
# Optional: better web.search than DuckDuckGo HTML
BRAVE_API_KEY=
# Optional: TTS for telegram.send_voice / llm.speak
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy
# Optional: social connector (also set in the Social connection card)
VK_ACCESS_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
LINKEDIN_ACCESS_TOKEN=
SOCIAL_PROVIDER_BASE_URL=
SOCIAL_PROVIDER_API_KEY=
