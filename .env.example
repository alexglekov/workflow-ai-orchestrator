# Local: npm run db:up (Postgres on localhost:5436)
DATABASE_URL=postgresql://aiworker:aiworker@localhost:5436/aiworker?schema=public
ENCRYPTION_KEY=dev-encryption-key-change-me

# --- DigitalOcean / docker-compose.prod.yml ---
# docker compose --env-file .env -f infra/docker/docker-compose.prod.yml up -d --build
POSTGRES_USER=aiworker
POSTGRES_PASSWORD=
POSTGRES_DB=aiworker
# Caddy site: domain for HTTPS, or http://:80 for IP/HTTP only
CADDY_SITE=http://:80
# Host ports. Use 8080/8443 if nginx/apache already binds 80/443
WEB_HTTP_PORT=80
WEB_HTTPS_PORT=443
# Public API URL (Telegram webhook needs https)
PUBLIC_API_URL=http://localhost/api
API_PASSWORD=
# Same-origin behind Caddy — leave empty. Split frontend: https://app.example.com
CORS_ORIGIN=

PORT=3000
SCHEDULE_TZ=Europe/Moscow
AGENT_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Official Google endpoint is geo-blocked in some countries; use a proxy URL if needed.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Qwen — ключ Alibaba Model Studio (DashScope). Ключ привязан к региону:
# база должна быть из того же региона, иначе 401.
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
# Озвучка и распознавание голоса идут через Qwen.
QWEN_TTS_MODEL=qwen3-tts-flash
QWEN_TTS_VOICE=Cherry
QWEN_TRANSCRIBE_MODEL=qwen3-asr-flash
# Голосовые Telegram требуют OGG/Opus. В Docker ffmpeg уже в образе,
# локально — brew install ffmpeg, иначе озвучка уйдёт обычным аудио.
FFMPEG_PATH=
# Web search. Без ключей ищут DuckDuckGo Lite, Bing и Chromium из образа.
# С серверного IP их чаще режет анти-бот, поэтому на прод стоит завести ключ.
BRAVE_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
SERPER_API_KEY=
TAVILY_API_KEY=
VK_ACCESS_TOKEN=
VK_API_VERSION=5.199
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_GRAPH_VERSION=v21.0
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_VERSION=202401
SOCIAL_PROVIDER_BASE_URL=
SOCIAL_PROVIDER_API_KEY=
WEB_USER_AGENT=
# Пусто в Docker: Chromium лежит в образе. Задайте путь только для локального запуска.
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=
