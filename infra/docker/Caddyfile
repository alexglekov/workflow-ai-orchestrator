{$CADDY_SITE:http://:80} {
	encode gzip zstd

	handle /api* {
		reverse_proxy api:3000 {
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
			header_up X-Real-IP {remote_host}
			transport http {
				read_timeout 5m
				write_timeout 5m
			}
		}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
