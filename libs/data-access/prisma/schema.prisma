generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Connection {
  id             String   @id @default(uuid())
  connectorId    String
  name           String
  credentialsEnc String
  status         String   @default("disconnected")
  lastError      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Workflow {
  id        String          @id @default(uuid())
  name      String
  prompt    String          @default("")
  steps     WorkflowStep[]
  runs      Run[]
  triggers  Trigger[]
  state     WorkflowState[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model WorkflowStep {
  id           String   @id @default(uuid())
  workflowId   String
  workflow     Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  order        Int
  title        String
  connectorId  String
  action       String
  params       Json     @default("{}")
  connectionId String?
  iterate      Boolean  @default(false)

  @@index([workflowId, order])
}

model Trigger {
  id          String    @id @default(uuid())
  workflowId  String
  workflow    Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  type        String
  enabled     Boolean   @default(true)
  config      Json      @default("{}")
  token       String?   @unique
  lastFiredAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workflowId])
  @@index([enabled, type])
}

model Run {
  id               String    @id @default(uuid())
  workflowId       String
  workflow         Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  status           String    @default("pending")
  source           String    @default("manual")
  triggerId        String?
  input            Json?
  lockedAt         DateTime?
  lockedBy         String?
  cancelRequested  Boolean   @default(false)
  startedAt        DateTime?
  finishedAt       DateTime?
  steps            RunStep[]
  createdAt        DateTime  @default(now())

  @@index([status, createdAt])
  @@index([workflowId, status])
}

model RunStep {
  id             String    @id @default(uuid())
  runId          String
  run            Run       @relation(fields: [runId], references: [id], onDelete: Cascade)
  workflowStepId String?
  order          Int
  title          String
  connectorId    String
  action         String
  status         String    @default("pending")
  input          Json?
  output         Json?
  error          String?
  startedAt      DateTime?
  finishedAt     DateTime?

  @@index([runId, order])
}

model WorkflowState {
  id         String   @id @default(uuid())
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  key        String
  value      Json
  updatedAt  DateTime @updatedAt

  @@unique([workflowId, key])
  @@index([workflowId])
}
